#!/bin/sh
# Small operator dispatcher. It keeps credentials out of argv/history and
# exposes an explicit spend boundary.
set -eu
set +x
umask 077
ulimit -c 0 2>/dev/null || true

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SERVER_ENV=${CYBERGYM_SERVER_ENV:-/etc/cybergym/server.env}
RUNNER_ENV=${CYBERGYM_RUNNER_ENV:-/etc/cybergym/runner.env}

usage() {
    cat <<'EOF'
Usage: cybergym-ops COMMAND [ARGS]

Commands:
  setup                 Install/build the pinned no-model runner
  preflight             Authenticate and validate without a model call
  smoke --confirm-spend Run one arvo:10400 rollout at concurrency 1
  campaign-preflight    Validate all 1,507 tasks without a model call
  campaign              Resume the spend-gated 200-step full campaign
  daytona-preflight     Prove private Daytona placement without a model call
  daytona-ready         Build the canonical 24x8 Daytona plan without inference
  daytona-lane          Run or resume one planned Daytona lane
  daytona-control       Status, boundary-pause, or resume one Daytona lane
  daytona-campaign      Resume the selected direct-Anthropic Daytona campaign
  daytona-canary        Run one isolated paid Opus 5 validation task
  daytona-missing-pass1 Run the scored-complement pass@1 task file
  daytona-continue-pass3 Run only full-catalog rounds 2 and 3
  daytona-finalize      Finalize the strict local 4,521-row pass@3 ledger
  daytona-round-barrier Seal one globally complete repeat
  server-status         Show the private server service state
EOF
}

[ "$#" -gt 0 ] || { usage >&2; exit 2; }
COMMAND=$1
shift

case "$COMMAND" in
    -h|--help|help) usage; exit 0 ;;
    setup) exec "$SCRIPT_DIR/setup.sh" "$@" ;;
    server-status) exec systemctl status --no-pager cybergym-server.service ;;
    preflight|smoke|campaign-preflight|campaign|daytona-preflight|daytona-ready|daytona-lane|daytona-control|daytona-campaign|daytona-canary|daytona-missing-pass1|daytona-continue-pass3|daytona-finalize|daytona-round-barrier)
        for path in "$SERVER_ENV" "$RUNNER_ENV"; do
            [ -r "$path" ] || { printf 'cybergym-ops: missing readable secret file: %s\n' "$path" >&2; exit 1; }
            mode=$(stat -c '%a' "$path")
            case "$mode" in 600|640) ;; *) printf 'cybergym-ops: unsafe mode %s on %s\n' "$mode" "$path" >&2; exit 1 ;; esac
        done
        set -a
        # shellcheck disable=SC1090
        . "$SERVER_ENV"
        # shellcheck disable=SC1090
        . "$RUNNER_ENV"
        set +a
        case "$COMMAND" in daytona-*)
            DAYTONA_ENV=${CYBERGYM_DAYTONA_ENV:-/etc/cybergym/daytona.env}
            [ -r "$DAYTONA_ENV" ] \
                || { printf 'cybergym-ops: missing readable secret file: %s\n' "$DAYTONA_ENV" >&2; exit 1; }
            case "$(stat -c '%a' "$DAYTONA_ENV")" in
                600|640) ;;
                *) printf 'cybergym-ops: unsafe mode on %s\n' "$DAYTONA_ENV" >&2; exit 1 ;;
            esac
            set -a
            # shellcheck disable=SC1090
            . "$DAYTONA_ENV"
            RELAY_ENV=${CYBERGYM_RELAY_ENV:-/etc/cybergym/relay.env}
            [ -r "$RELAY_ENV" ] \
                || { printf 'cybergym-ops: missing readable secret file: %s\n' "$RELAY_ENV" >&2; exit 1; }
            case "$(stat -c '%a' "$RELAY_ENV")" in
                600|640) ;;
                *) printf 'cybergym-ops: unsafe mode on %s\n' "$RELAY_ENV" >&2; exit 1 ;;
            esac
            # shellcheck disable=SC1090
            . "$RELAY_ENV"
            set +a
            case "$COMMAND" in daytona-lane|daytona-control|daytona-canary|daytona-missing-pass1|daytona-continue-pass3|daytona-finalize|daytona-round-barrier)
                DAYTONA_RUN_ENV=${CYBERGYM_DAYTONA_RUN_ENV:-${XDG_CONFIG_HOME:-$HOME/.config}/cybergym/daytona-run.env}
                [ -f "$DAYTONA_RUN_ENV" ] \
                    || { printf 'cybergym-ops: run daytona-ready first; missing %s\n' "$DAYTONA_RUN_ENV" >&2; exit 1; }
                case "$(stat -c '%a' "$DAYTONA_RUN_ENV")" in
                    600) ;;
                    *) printf 'cybergym-ops: unsafe mode on %s\n' "$DAYTONA_RUN_ENV" >&2; exit 1 ;;
                esac
                set -a
                # shellcheck disable=SC1090
                . "$DAYTONA_RUN_ENV"
                set +a
                ;; esac
            ;; esac
        case "$COMMAND" in
            preflight) exec "$SCRIPT_DIR/preflight.sh" "$@" ;;
            smoke) exec "$SCRIPT_DIR/smoke.sh" "$@" ;;
            campaign-preflight) exec "$SCRIPT_DIR/campaign-preflight.sh" "$@" ;;
            campaign) exec "$SCRIPT_DIR/campaign.sh" "$@" ;;
            daytona-preflight) exec "$SCRIPT_DIR/daytona-preflight.sh" "$@" ;;
            daytona-ready) exec "$SCRIPT_DIR/daytona-ready.sh" "$@" ;;
            daytona-lane) exec "$SCRIPT_DIR/daytona-lane.sh" "$@" ;;
            daytona-control) exec "$SCRIPT_DIR/daytona-control.sh" "$@" ;;
            daytona-campaign) exec "$SCRIPT_DIR/daytona-campaign.sh" "$@" ;;
            daytona-canary) exec "$SCRIPT_DIR/daytona-canary.sh" "$@" ;;
            daytona-missing-pass1) exec "$SCRIPT_DIR/run-missing-pass1.sh" "$@" ;;
            daytona-continue-pass3) exec "$SCRIPT_DIR/continue-pass3.sh" "$@" ;;
            daytona-finalize) exec "$SCRIPT_DIR/daytona-finalize.sh" "$@" ;;
            daytona-round-barrier) exec "$SCRIPT_DIR/daytona-round-barrier.sh" "$@" ;;
        esac
        ;;
    *) printf 'cybergym-ops: unknown command: %s\n' "$COMMAND" >&2; exit 2 ;;
esac
