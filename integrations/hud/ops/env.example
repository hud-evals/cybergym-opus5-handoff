# Copy this file OUTSIDE the checkout, fill it there, and chmod it 600.
# It contains no credentials and is safe to commit.

# HUD telemetry. Required if Jobs/Traces must appear on hud.ai.
HUD_API_KEY=

# The private PoC server and HUD grader must receive the same value.
CYBERGYM_API_KEY=

# Set only the provider key selected by CG_MODEL.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_API_KEY=

# Non-secret operator paths/settings. CG_* names deliberately do not overlap
# the upstream server's CYBERGYM_* pydantic settings namespace.
CG_REPOSITORY_ROOT=
CG_DATA_DIR=
CG_SERVER_URL=
CG_RESULTS_DIR=
CG_MODEL=claude-sonnet-4-5
CG_MODEL_BASE_URL=
CG_SMOKE_TASK_ID=arvo:10400
